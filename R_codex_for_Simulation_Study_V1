#------------------------------------------------------------------------------
#  Cauchy combination function (Liu & Xie 2020)
#  Input:  p = vector of p-values in (0,1)
#  Output: a single combined p-value
#------------------------------------------------------------------------------
cauchy_combine <- function(p) {
  # Transform p-values via inverse Cauchy CDF (tan((0.5 - p)*pi))
  # Remove p-values that are exactly 0 or 1
  p <- p[p > 0 & p < 1]
  if (length(p) == 0) return(1)
  if (length(p) == 1) return(p)
  
  stat <- sum(tan((0.5 - p) * pi), na.rm = TRUE)
  # Two-sided p-value from standard Cauchy
  combined_p <- 0.5 - atan(abs(stat)) / pi
  return(combined_p)
}

