#==============================================================================
#  3. MAIN SIMULATION DRIVER
#==============================================================================
#' Run a complete simulation replicate
#'
#' @param seed       Random seed for this replicate
#' @param n          Sample size
#' @param N          Number of grid points per gene region
#' @param dim1       Dimension per gene region
#' @param group_num  Number of gene regions
#' @param K1         Number of active FPC components
#' @param rho        Autocorrelation parameter
#' @param logic_num  Outcome type: 1 = continuous, 2 = binary
#' @param pve        Proportion of variance explained for FPCA
#'
#' @return A matrix of p-values with rows:
#'   P_alpha, Fisher_P, Min_P, Cauchy_P
#'   and columns named by gene region.
run_simulation <- function(seed, n = 400, N = 100, dim1 = 4, group_num = 4,
                           K1 = 4, rho = 0, logic_num = 2, pve = 0.95) {
  
  cat(sprintf("[Seed %d] Generating data...\n", seed))
  
  #--- Step 1: Generate data ---
  sim_data <- gen_sim_data(
    n = n, N = N, group_num = group_num, dim1 = dim1,
    K1 = K1, rho = rho, logic_num = logic_num, seed = seed
  )
  
  X <- sim_data$X
  Y <- sim_data$Y
  M_list <- sim_data$M_values_list
  
  #--- Step 2: Wilks' Lambda screening via FPCA ---
  cat(sprintf("[Seed %d] Running Wilks' Lambda test...\n", seed))
  
  wl_res <- wilks_lambda_test(M_list, X, pve = pve)
  
  fpc_scores <- wl_res$fpc_scores
  fda_P_values <- wl_res$p_values
  
  # Name the FPC score columns
  for (f in 1:length(fpc_scores)) {
    colnames(fpc_scores[[f]]) <- paste0("fda_group-", f, "-", 1:ncol(fpc_scores[[f]]))
  }
  
  #--- Step 3: Combine FPC scores and run de-sparsified Lasso ---
  cat(sprintf("[Seed %d] Fitting de-sparsified Lasso...\n", seed))
  
  fpca_all <- Reduce(cbind, fpc_scores)
  design_matrix <- cbind(fpca_all, X)
  
  if (logic_num == 1) {
    hdi_lasso <- hdi::lasso.proj(design_matrix, Y)
  } else {
    hdi_lasso <- hdi::lasso.proj(design_matrix, Y, family = "binomial")
  }
  
  all_pvalues <- as.matrix(hdi_lasso$pval, 1)
  
  #--- Step 4: Group p-values by gene region ---
  group_id <- list()
  for (f in 1:length(fpc_scores)) {
    group_id[[f]] <- rep(f, ncol(fpc_scores[[f]]))
  }
  group_vector <- as.matrix(unlist(group_id), 1)
  
  com_P <- cbind(all_pvalues[1:dim(fpca_all)[2]], group_vector)
  com_P <- cbind(com_P, seq(1:dim(com_P)[1]))
  colnames(com_P) <- c("P_value", "Index", "Order")
  
  #--- Step 5: Combine p-values within each gene region ---
  fisher_P <- list()
  cauchy_P <- list()
  group_test_indices <- list()
  
  for (j1 in 1:length(fpc_scores)) {
    idx <- which(com_P[, 2] == j1)
    group_p <- com_P[, 1][idx]
    group_test_indices[[j1]] <- com_P[, 3][idx]
    
    if (length(group_p) == 1) {
      fisher_P[[j1]] <- group_p
      cauchy_P[[j1]] <- group_p
    } else {
      fisher_P[[j1]] <- metap::sumlog(group_p)$p
      cauchy_P[[j1]] <- cauchy_combine(group_p)
    }
  }
  
  #--- Step 6: Group test via hdi ---
  group_pvalue_max <- hdi_lasso$groupTest(group_test_indices)
  
  #--- Step 7: Assemble final results ---
  note_total <- character(length(fpc_scores))
  for (j3 in 1:length(fpc_scores)) {
    note_total[j3] <- colnames(fpc_scores[[j3]])[1]
  }
  
  final_fisher <- unlist(fisher_P)
  final_max   <- group_pvalue_max
  final_cauchy <- unlist(cauchy_P)
  sjt_P <- apply(rbind(fda_P_values, final_fisher), 2, max)
  ending_P <- rbind(fda_P_values, fda_P_values, final_fisher, final_max, final_cauchy, sjt_P)
  colnames(ending_P) <- note_total
  rownames(ending_P) <- c("P_alpha", "Fisher_P", "Min_P", "Cauchy_P")
  
  cat(sprintf("[Seed %d] Done.\n", seed))
  
  return(ending_P)
}
