#==============================================================================
#  2. WILKS' LAMBDA TEST FUNCTION
#==============================================================================
#' Perform Wilks' Lambda multivariate test for mediation screening
#'
#' @param M_list  List of observed methylation matrices (one per gene region)
#' @param X       Exposure variable (n x 1 matrix)
#' @param pve     Proportion of variance explained for FPCA truncation (default = 0.95)
#'
#' @return A list containing:
#'   $p_values       - Vector of p-values from Wilks' Lambda test (one per gene region)
#'   $stat_values    - Vector of Wilks' Lambda statistics
#'   $fpc_scores     - List of FPCA scores (one per gene region)
#'   $npc            - Vector of number of principal components retained
wilks_lambda_test <- function(M_list, X, pve = 0.95) {
  
  n_groups <- length(M_list)
  fpc_scores <- list()
  p_values   <- numeric(n_groups)
  stat_values <- numeric(n_groups)
  npc_vec    <- numeric(n_groups)
  
  for (ss in 1:n_groups) {
    M_mat <- M_list[[ss]]
    num_sites <- ncol(M_mat)
    
    #--- FPCA via fdapace ---
    fpca.res <- fdapace::fpca.sc(
      scale(M_mat),
      argvals = c(1:num_sites),
      pve = pve,
      var = TRUE
    )
    
    scores <- fpca.res$scores
    npc    <- fpca.res$npc
    fpc_scores[[ss]] <- scores
    npc_vec[ss]      <- npc
    
    #--- Multivariate regression: FPC scores ~ X ---
    colnames(scores) <- paste0("PC", 1:npc)
    dat <- data.frame(scores, X = X)
    
    multivar_fit <- lm(as.matrix(dat[, 1:npc]) ~ X)
    
    #--- Wilks' Lambda via car::Anova ---
    av <- car::Anova(multivar_fit)
    av_summary <- summary.Anova.mlm(av)
    
    test_x <- av_summary$multivariate.tests$X
    
    # Eigenvalues of SSPE^{-1} SSPH
    SSPE.qr <- qr(test_x$SSPE)
    eigs <- Re(eigen(qr.coef(SSPE.qr, test_x$SSPH), symmetric = FALSE)$values)
    
    # Wilks' Lambda statistic and p-value
    wl <- Wilks(eigs, test_x$df, test_x$df.residual)
    
    stat_values[ss] <- wl[1]   # Wilks' Lambda statistic
    p_values[ss]     <- pf(wl[2], wl[3], wl[4], lower.tail = FALSE)
  }
  
  result <- list(
    p_values    = p_values,
    stat_values = stat_values,
    fpc_scores  = fpc_scores,
    npc         = npc_vec
  )
  
  return(result)
}
