# 1. DATA GENERATION FUNCTION
#==============================================================================
#' Generate simulated data for high-dimensional mediation analysis
#'
#' @param n          Sample size (default = 400)
#' @param N          Number of grid points / CpG sites per gene region (default = 100)
#' @param group_num  Number of gene regions (default = 4)
#' @param dim1       Dimension (number of CpG sites) per gene region (default = 4)
#' @param K1         Number of active FPC components (default = 4)
#' @param rho        Autocorrelation parameter for error covariance (default = 0)
#' @param logic_num  Outcome type: 1 = continuous, 2 = binary (default = 2)
#' @param seed       Random seed for reproducibility
#'
#' @return A list containing:
#'   $X              - Exposure variable (n x 1)
#'   $Y              - Outcome variable (n x 1)
#'   $M_values_list  - List of observed methylation matrices (one per gene region)
#'   $M_tuta_list    - List of true underlying mediator values (one per gene region)
#'   $alpha           - True alpha coefficients (mediation effects)
#'   $beta            - True beta coefficients (outcome effects)
#'   $active_set_1    - Indices of active mediators in group 1
#'   $active_set_3    - Indices of active mediators in group 3
#'   $series          - Vector of dimensions for each gene region
gen_sim_data <- function(n = 400, N = 100, group_num = 4, dim1 = 10, 
                         K1 = 4, rho = 0, logic_num = 2, seed = 12345) {
  total_K <- group_num * K1

  set.seed(seed + 12345)

  X <- matrix(rbinom(n, 1, 0.5), ncol = 1)
  
  coef_list <- list()
  obs_list <- list()
  
  # ---------- 基函数生成（修正部分）----------
  tt <- (1:N) / N
  if (K1 == 1) {
    # 仅常数基
    f2 <- matrix(rep(1, N), nrow = 1) / sqrt(N)
  } else {
    # 正交多项式（不含常数项），维度 N × (K1-1)
    poly_mat <- poly(tt, degree = K1 - 1)  # N x (K1-1)
    # 常数项（归一化使得平方和 = N）
    const <- rep(1, N) / sqrt(N)           # 1 x N
    # 合并：K1 x N
    f2 <- rbind(const, t(poly_mat))
    # 归一化每行使得平方和 ≈ N（与常数项尺度一致）
    row_norm <- sqrt(rowSums(f2^2) / N)
    f2 <- f2 / row_norm
  }
  # ------------------------------------------
  
  for (J in 1:group_num) {
    sigma_coef <- matrix(0, K1, K1)
    for (i in 1:K1) for (j in 1:K1) sigma_coef[i, j] <- rho^(abs(i - j))
    
    alpha <- rep(0, K1)
    if (J == 1) {
      alpha[1:min(K1, 4)] <- seq(0.2, 0.5, length.out = min(K1, 4))
    } else if (J == 2) {
      alpha[1:min(K1, 4)] <- seq(0.2, 0.5, length.out = min(K1, 4))
    } else {
      alpha <- rep(0, K1)
    }
    
    ava <- rep(0, K1)
    set.seed(seed + J)
    e_coef <- mvrnorm(n, mu = ava, Sigma = sigma_coef)
    coef_mat <- e_coef + X %*% t(alpha)
    
    curve <- coef_mat %*% f2   # n × N
    
    set.seed(seed + J + 100)
    obs_indices <- sort(sample(1:N, size = dim1, replace = FALSE))
    M_obs_noiseless <- curve[, obs_indices]
    
    sigma_obs <- matrix(0, dim1, dim1)
    for (i in 1:dim1) for (j in 1:dim1) sigma_obs[i, j] <- rho^(abs(i - j))
    set.seed(J + 20121)
    e_obs <- mvrnorm(n, mu = rep(0, dim1), Sigma = 1.5 * sigma_obs)
    M_obs <- M_obs_noiseless + e_obs
    
    coef_list[[J]] <- coef_mat
    obs_list[[J]] <- M_obs
  }
  
  all_coef <- do.call(cbind, coef_list)
  all_coef_with_X <- cbind(all_coef, X)
  
  set.seed(seed + 29861)
  active_1 <- 1:K1
  active_2 <- (K1+1):(2*K1)
  active_all <- c(active_1, active_2)
  
  beta_true <- rep(0, total_K)
  beta_true[active_1] <- 0.1
  beta_true[active_2] <- 0.1
  B <- c(beta_true, 0.2)
  
  set.seed(seed + 32321)
  E <- rnorm(n, mean = 0, sd = 1)
  Y0 <- -3.5 + all_coef_with_X %*% B
  
  if (logic_num == 1) {
    Y <- Y0 + E
  } else {
    Y <- matrix(rbinom(n, 1, 1/(1 + exp(-Y0))), nrow = n)
  }
  
  list(
    X = X, Y = Y,
    M_values_list = obs_list,
    coef_list = coef_list,
    beta = beta_true, B = B,
    active_set = active_all,
    series = rep(dim1, group_num),
    n = n, N = N, group_num = group_num, dim1 = dim1, K1 = K1
  )
}
