# 1. DATA GENERATION FUNCTION
#==============================================================================
#' Generate simulated data for high-dimensional mediation analysis
#'
#' @param n          Sample size (default = 400)
#' @param N          Number of grid points / CpG sites per gene region (default = 100)
#' @param group_num  Number of gene regions (default = 4)
#' @param dim1       Dimension (number of CpG sites) per gene region (default = 4)
#' @param K1         Number of active FPC components (default = 4)
#' @param rho        Autocorrelation parameter for error covariance (default = 0)
#' @param logic_num  Outcome type: 1 = continuous, 2 = binary (default = 2)
#' @param seed       Random seed for reproducibility
#'
#' @return A list containing:
#'   $X              - Exposure variable (n x 1)
#'   $Y              - Outcome variable (n x 1)
#'   $M_values_list  - List of observed methylation matrices (one per gene region)
#'   $M_tuta_list    - List of true underlying mediator values (one per gene region)
#'   $alpha           - True alpha coefficients (mediation effects)
#'   $beta            - True beta coefficients (outcome effects)
#'   $active_set_1    - Indices of active mediators in group 1
#'   $active_set_3    - Indices of active mediators in group 3
#'   $series          - Vector of dimensions for each gene region
gen_sim_data <- function(n = 400, N = 100, group_num = 4, dim1 = 4,
                         K1 = 4, rho = 0, logic_num = 2, seed = 12345) {
  
  set.seed(seed)
  
  #--- Design parameters ---
  series <- rep(dim1, group_num)          # each gene region has 'dim1' CpG sites
  t1 <- seq(0, 1, length = N)
  tlength <- 1
  
  #--- Exposure X: binary ---
  X <- matrix(rbinom(n, 1, 0.5), ncol = 1)
  
  #--- Identify active mediator positions ---
  s_vector1 <- c(1:series[1])
  s_vector3 <- c((1 + sum(series[1:2])):(sum(series[1:3])))
  
  #--- Orthogonal basis functions on [0,1] ---
  tt <- t1 / tlength
  f2 <- matrix(0, nrow = K1, ncol = N)
  f2[1, ] <- rep(1, N) * sqrt(1 / tlength)
  f2[2, ] <- sqrt(3 / tlength) * (2 * tt - 1)
  f2[3, ] <- sqrt(5 / tlength) * (6 * tt^2 - 6 * tt + 1)
  f2[4, ] <- sqrt(7 / tlength) * (20 * tt^3 - 30 * tt^2 + 12 * tt - 1)
  
  #--- Generate mediators for each gene region ---
  M_values_list <- list()
  M_tuta_list   <- list()
  
  for (J in 1:group_num) {
    m <- series[J]
    
    # Covariance matrix with AR(1) structure
    sigma <- matrix(0, m, m)
    for (i in 1:m) {
      for (j in 1:m) {
        sigma[i, j] <- rho^(abs(i - j))
      }
    }
    
    # Alpha coefficients: only groups 1 and 2 have non-zero effects
    alpha <- rep(0, m)
    if (J %in% c(1, 2)) {
      alpha[1:4] <- seq(0.2, 0.5, by = 0.1)
    }
    alpha1 <- matrix(alpha, 1, m)
    x_and_alpha <- X %*% alpha1            # n x m
    
    # Random error for mediators
    e <- MASS::mvrnorm(n, mu = rep(0, m), Sigma = sigma)
    
    M_tuta <- e + x_and_alpha              # True latent mediators (n x m)
    
    # Project onto functional basis to get smooth trajectories
    M <- matrix(0, n, N)
    for (j in 1:n) {
      M[j, ] <- apply((M_tuta[j, ] %*% t(rep(1, N))) * f2, 2, sum)
    }
    
    # Add measurement noise
    sigma1 <- matrix(0, N, N)
    for (i in 1:N) {
      for (j in 1:N) {
        sigma1[i, j] <- rho^(abs(i - j))
      }
    }
    e1 <- MASS::mvrnorm(n, mu = rep(0, N), Sigma = 1.5 * sigma1)
    
    M_observed <- M + e1
    
    M_values_list[[J]] <- M_observed
    M_tuta_list[[J]]   <- M_tuta
  }
  
  #--- Outcome Y ---
  # Combine all latent mediators
  M_all <- Reduce(cbind, M_tuta_list)
  M_all_and_X <- cbind(M_all, X)
  
  # Select active beta positions
  set.seed(seed + 999)
  a1 <- sample(s_vector1, size = K1, replace = FALSE)
  c1 <- sample(s_vector3, size = K1, replace = FALSE)
  
  beta <- rep(0, sum(series))
  beta[a1] <- rep(0.1, K1)
  beta[c1] <- rep(0.1, K1)
  B <- c(beta, 0.2)   # last entry = direct effect of X on Y
  
  Y0 <- -3.5 + M_all_and_X %*% matrix(B, ncol = 1)
  E  <- rnorm(n, mean = 0, sd = 1)
  
  if (logic_num == 1) {
    Y <- Y0 + E
  } else {
    prob <- 1 / (1 + exp(-Y0))
    Y <- matrix(rbinom(n, 1, prob), nrow = n)
  }
  
  #--- Return all components ---
  result <- list(
    X = X,
    Y = Y,
    M_values_list = M_values_list,
    M_tuta_list   = M_tuta_list,
    alpha = alpha,
    beta  = beta,
    active_set_1 = a1,
    active_set_3 = c1,
    series       = series,
    N = N,
    n = n,
    K1 = K1,
    group_num = group_num
  )
  
  return(result)
}
