# # Run multiple replicates and aggregate
 n_rep <- 200
 results_list <- list()
 for (r in 1:n_rep) {
   seed_r <- 12345 + r
   results_list[[r]] <- run_simulation(seed = seed_r)
 }
# # Aggregate power: proportion of p-values < 0.05 for each row/column
 aggregate_power <- function(results_list, alpha = 0.05) {
   mat <- results_list[[1]]
   count_sig <- matrix(0, nrow = nrow(mat), ncol = ncol(mat))
   rownames(count_sig) <- rownames(mat)
   colnames(count_sig) <- colnames(mat)  
   for (r in results_list) {
     count_sig <- count_sig + (r < alpha)
 }
   power <- count_sig / length(results_list)
   return(power)
 }
 power_summary <- aggregate_power(results_list)
 print(power_summary)
